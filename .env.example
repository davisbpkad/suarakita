# Server lokal membaca .env melalui Node.js loadEnvFile (Node 20.12+).
# Jangan gunakan awalan VITE_ untuk kredensial.
PORT=3088
GEMINI_API_KEY=
GROQ_API_KEY=
# Wajib diisi (minimal 12 karakter). Tanpa ini endpoint AI menolak dengan 503.
APP_PASSWORD=
# Opsional; bila kosong dipakai APP_PASSWORD. Ganti tanpa memaksa semua sesi keluar.
SESSION_SECRET=
