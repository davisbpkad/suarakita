# Variabel environment untuk server lokal (server.js).
#
# PENTING: proyek ini TIDAK memuat file .env secara otomatis (tidak ada dotenv).
# Nilai di bawah harus diekspor di shell, contoh:
#   PORT=3001 GEMINI_API_KEY=xxx node server.js

# Port server Express lokal. Default 3000 kalau tidak diisi.
PORT=3001

# Opsional, KHUSUS PEMAKAIAN LOKAL.
# Jangan diisi di environment Netlify: endpoint produksi sengaja tidak memakai
# key milik server supaya kuota Anda tidak bisa dihabiskan pihak lain.
# Di browser, API key diisi lewat menu Pengaturan AI dan disimpan di localStorage.
GEMINI_API_KEY=
GOOGLE_API_KEY=
